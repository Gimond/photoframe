# Configuration locale (copier en .env)

# OpenWeather
OPENWEATHER_API_KEY=
CITY=Massingy,fr

# Calendar (liste separee par des virgules)
GOOGLE_CALENDAR_ICS_URLS=

# Endpoint(s) PhotoFrame (liste separee par des virgules)
PHOTOFRAME_API_URLS=http://192.168.1.50/api/display-image

# TMDB (liste utilisateur)
TMDB_API_KEY=
TMDB_LIST_ID=

# Planning automatique des ecrans
SCREEN_SCHEDULE_FILE=schedule.json
SCREEN_SCHEDULE_WINDOW_MINUTES=30
SCREEN_SCHEDULE_STATE_FILE=.schedule_state.json
